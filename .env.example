# RepoUplink Environment Configuration
# Copy this file to .env and customize the values

# Flask Configuration
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Secret Key (IMPORTANT: Change this in production!)
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Settings file location (for Docker, use /app/data/settings.json)
SETTINGS_FILE=/app/data/settings.json

# Optional: GitHub Token (NOT RECOMMENDED - use web interface instead)
# For security, it's better to enter your token through the web interface
# GITHUB_TOKEN=your_github_token_here
